<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Buds Bridge"
            android:textColor="@color/on_surface"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="OnePlus Buds 3 için pop-up, canlı bildirim ve widget"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:id="@+id/tvDevice"
                    android:text="OnePlus Buds"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/heroImg"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="12dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <include android:id="@+id/colLeft" layout="@layout/part_battery_col"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include android:id="@+id/colCase" layout="@layout/part_battery_col"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" />
                <include android:id="@+id/colRight" layout="@layout/part_battery_col"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:text="Görünüm"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:id="@+id/toggleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:text="İzinler"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:id="@+id/permContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="Cihazlar"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:id="@+id/deviceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="Görseller"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="HeyMelody'de kulaklık sayfasının ekran görüntüsünü al, aşağıdaki ilk butonla seç: ürün görseli otomatik kesilir ve arka planı şeffaf yapılır."
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnMeta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:stateListAnimator="@null"
            android:text="Ekran görüntüsünden ana görsel al (önerilen)"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_container"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:stateListAnimator="@null"
            android:text="HeyMelody görsellerinden elle seç"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_container"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:stateListAnimator="@null"
            android:text="Dosyadan içe aktar (left / right / case)"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_container"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:stateListAnimator="@null"
            android:text="Detaylı teşhis raporu (dosya)"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_container"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:stateListAnimator="@null"
            android:text="Görselleri sıfırla"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_container"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDemo"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_tonal"
                android:stateListAnimator="@null"
                android:text="Demo"
                android:textAllCaps="false"
                android:textColor="@color/on_accent_container"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_tonal"
                android:stateListAnimator="@null"
                android:text="Durdur"
                android:textAllCaps="false"
                android:textColor="@color/on_accent_container"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
